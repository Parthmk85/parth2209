  "content": [
    {
      "section": "hero",
      "data": {
        "heading": "We build websites, online stores, apps and custom CRM software for growing businesses.",
        "subtext": "EZcods IT Solutions is a software development company in India, founded by Parth Patel. Tell us what your business needs: we plan it, build it and launch it.",
        "image": "https://res.cloudinary.com/dpet9memo/image/upload/v1776838685/portfolio/xrvfrhaixxuhunap8oav.jpg"
      }
    },
    {
      "section": "about",
      "data": {
        "text1": "EZcods IT Solutions is an Indian software development company. We build business websites, e-commerce stores, Android and iOS apps, and custom CRM and ERP software.",
        "text2": "We start with how your business already works and build around it: fast, mobile-first websites, stores you can run from an admin panel, and software that fits your team instead of the other way round.",
        "text3": "Every project starts with a free discovery call. You get a clear approach, an indicative timeline and budget, and a team that stays with you until it is live.",
        "image": "https://res.cloudinary.com/dpet9memo/image/upload/v1776840485/portfolio/nu4p0qp2gssavrlsqfnc.png"
      }
    },
    {
